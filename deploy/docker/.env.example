# Copy to .env on the production server, fill it in, then: chmod 600 .env
# This file is the template and is committed. The .env it becomes is not, and
# .gitignore keeps it that way.

# --- Database ----------------------------------------------------------------
POSTGRES_DB=woodheart
POSTGRES_USER=woodheart
# openssl rand -base64 32
POSTGRES_PASSWORD=

# --- API ---------------------------------------------------------------------
# At least 32 characters. The API will not start with anything shorter.
# openssl rand -base64 48
JWT_SIGNING_KEY=

# --- Cloudinary --------------------------------------------------------------
# Product photography. Leave these blank and the site still works: uploads are
# refused with a message saying why, and the storefront renders placeholder
# tiles. Fill them in and the shop can put photographs on products.
#
# All three come from the Cloudinary console. The cloud name also goes to the
# web container, because it is the host of every image URL on every page; the
# key and the secret never leave the API.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# The folder every asset is written under. Keep this different from whatever
# development uses — sharing one folder means a staging tidy-up destroys live
# product photography.
CLOUDINARY_FOLDER=woodheart

# --- Public URLs -------------------------------------------------------------
PUBLIC_API_URL=https://api.woodheart.com.bd
PUBLIC_WEB_URL=https://woodheart.com.bd

# --- Image tags --------------------------------------------------------------
# "latest" tracks main. Pin a sha- tag to freeze a release or to roll back:
#   API_TAG=sha-4fd3343
API_TAG=latest
WEB_TAG=latest
