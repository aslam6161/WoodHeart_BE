# Copy to .env on the production server, fill it in, then: chmod 600 .env
# This file is the template and is committed. The .env it becomes is not, and
# .gitignore keeps it that way.

# --- Database ----------------------------------------------------------------
POSTGRES_DB=woodheart
POSTGRES_USER=woodheart
# openssl rand -base64 32
POSTGRES_PASSWORD=

# --- API ---------------------------------------------------------------------
# At least 32 characters. The API will not start with anything shorter.
# openssl rand -base64 48
JWT_SIGNING_KEY=

# --- Public URLs -------------------------------------------------------------
PUBLIC_API_URL=https://api.woodheart.com.bd
PUBLIC_WEB_URL=https://woodheart.com.bd

# --- Image tags --------------------------------------------------------------
# "latest" tracks main. Pin a sha- tag to freeze a release or to roll back:
#   API_TAG=sha-4fd3343
API_TAG=latest
WEB_TAG=latest
