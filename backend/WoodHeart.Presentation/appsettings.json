{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=woodheart;Username=woodheart;Password=woodheart"
  },
  "Jwt": {
    "Issuer": "WoodHeart",
    "Audience": "WoodHeart.Client",
    "SigningKey": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30
  },
  "Cloudinary": {
    "CloudName": "",
    "ApiKey": "",
    "ApiSecret": "",
    "Folder": "woodheart-dev",
    "MaxImageBytes": 12582912,
    "UploadTicketMinutes": 10
  },
  // Whether this process runs background jobs. True here because the API and
  // the worker share a process today; set BackgroundJobs__Enabled=false on the
  // web instances the day a separate worker container is worth having.
  "BackgroundJobs": {
    "Enabled": true,
    "WorkerCount": 4
  },
  // How hard the outbox worker tries. The numbers are money: SMS is billed per
  // part and a Bangla message costs a part every 70 characters, so an uncapped
  // retry loop is a line on an invoice.
  "Outbox": {
    "BatchSize": 25,
    "MaxAttempts": 5,
    "RetryBaseSeconds": 60,
    "RetryMaxSeconds": 3600
  },
  "Sms": {
    "BaseUrl": "https://api.sms.net.bd",
    // Deliberately blank. Anyone holding this can spend the shop's SMS
    // balance, so it is set with
    //   dotnet user-secrets set "Sms:ApiKey" "<key>"
    // locally, or Sms__ApiKey in production. Left empty, the API logs every
    // message it would have sent instead of failing — see
    // AddNotificationSettings.
    "ApiKey": "",
    "SenderId": "",
    "TimeoutSeconds": 30
  },
  // Email is the secondary channel: most customers here have no address they
  // read, and an order without one is not a failed notification. Password
  // blank for the same reason as above — user-secrets, or Email__Password.
  "Email": {
    "Host": "",
    "Port": 587,
    "UseStartTls": true,
    "Username": "",
    "Password": "",
    "FromAddress": "",
    "FromName": "WoodHeart",
    "TimeoutSeconds": 30
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200" ]
  },
  "Seed": {
    "Enabled": true,
    // The first administrator. Deliberately blank here: a committed password is
    // a published password. Set them with
    //   dotnet user-secrets set "Seed:Admin:PhoneNumber" "01712345678"
    //   dotnet user-secrets set "Seed:Admin:Password"    "<something long>"
    // locally, or Seed__Admin__PhoneNumber / Seed__Admin__Password in
    // production. Leaving them empty skips the seed and logs a warning.
    "Admin": {
      "PhoneNumber": "",
      "Password": ""
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {CorrelationId} {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/woodheart-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {CorrelationId} {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName" ]
  },
  "AllowedHosts": "*"
}
