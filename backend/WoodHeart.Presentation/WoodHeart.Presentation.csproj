<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    The host: controllers, middleware, DI composition, configuration. Contains
    no business logic — a controller builds a DTO, calls a service, and shapes
    the response.
  -->

  <PropertyGroup>
    <RootNamespace>WoodHeart.Presentation</RootNamespace>
    <UserSecretsId>woodheart-api-7f3c1a54-0b2e-4a19-9c8d-6e5b2f0a1d33</UserSecretsId>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Scalar.AspNetCore" />
    <PackageReference Include="Hangfire.AspNetCore" />
    <PackageReference Include="Hangfire.PostgreSql" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="Serilog.Enrichers.Environment" />
    <PackageReference Include="AspNetCore.HealthChecks.NpgSql" />
    <PackageReference Include="AspNetCore.HealthChecks.UI.Client" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WoodHeart.Service\WoodHeart.Service.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Startup validation (JwtSettings, payment provider config) is internal so
         it can be tested without booting the whole host. -->
    <InternalsVisibleTo Include="WoodHeart.Tests" />
  </ItemGroup>

  <!--
    Never publish developer settings into the image. CopyToPublishDirectory=Never
    keeps appsettings.Development.json available for local `dotnet run` while
    excluding it from `dotnet publish`.
  -->
  <ItemGroup>
    <Content Update="appsettings.Development.json" CopyToPublishDirectory="Never" />
    <None Update="appsettings.Development.json" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Templates\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <None Update="SeedJson\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>

</Project>
