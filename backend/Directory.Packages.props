<Project>

  <!--
    Central Package Management. Bento pins versions inline in each csproj; this
    is the one build-level thing WoodHeart does differently, and the reason is
    concrete rather than stylistic: Hangfire.Core pulls in Newtonsoft.Json
    11.0.1, which carries GHSA-5crp-9r3c-p9vr. CentralPackageTransitivePinning
    is what forces the patched version into the graph. Without it the only fix
    is an explicit reference in every project that transitively touches Hangfire.

    Practical difference when adding a package: write
    <PackageReference Include="X" /> with no version in the csproj, and put the
    version here.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <!-- ======================= Persistence ======================= -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.11" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.11" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.11" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageVersion Include="EFCore.NamingConventions" Version="10.0.1" />
  </ItemGroup>

  <!-- ========================= Service ========================= -->
  <ItemGroup>
    <!--
      Mapperly rather than Bento's AutoMapper, and not by preference — the
      choice is forced. GHSA-rvv3-g6hj-g44x (uncontrolled recursion, DoS via a
      self-referential object graph) covers every AutoMapper below 15.1.1, and
      15.x is where the licence turned commercial. Bento pins 12.0.1 and hides
      the warning with NuGetAuditLevel=critical; that is not a fix, and a
      category tree mapped from request data is exactly the self-referential
      shape the advisory describes.

      Mapperly is MIT, generates plain mapping code at compile time, and needs
      no runtime engine. Mappers live in Service/Mapping/ — the same place
      AutoMapper Profiles would.
    -->
    <PackageVersion Include="Riok.Mapperly" Version="4.3.1" />

    <!--
      JWT creation lives in Service.TokenService, because minting a token is a
      business decision (which claims, whose roles, how long) rather than an
      HTTP one. This is the pure token library — the ASP.NET
      Authentication.JwtBearer package that *validates* tokens stays in
      Presentation, where the middleware is. Same version the JwtBearer package
      resolves to, so the graph has one copy.
    -->
    <PackageVersion Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.19.2" />

    <!--
      Cloudinary is storage, transformation and CDN in one, which is why there
      is no ImageSharp here despite PLAN.md's original pick. Thumbnails are a
      URL, not a build step: no server-side resizing, no derivative files to
      keep in step with the original, and no second thing to back up.
    -->
    <PackageVersion Include="CloudinaryDotNet" Version="1.29.3" />
  </ItemGroup>

  <!-- =================== Framework abstractions ================ -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.11" />
  </ItemGroup>

  <!-- ======================= Web / API ========================= -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
    <PackageVersion Include="Scalar.AspNetCore" Version="2.17.1" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.11" />
    <PackageVersion Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Caching.Hybrid" Version="10.9.0" />
    <PackageVersion Include="AspNetCore.HealthChecks.NpgSql" Version="9.0.0" />
    <PackageVersion Include="AspNetCore.HealthChecks.UI.Client" Version="9.0.0" />
  </ItemGroup>

  <!-- ======================= Background jobs =================== -->
  <ItemGroup>
    <PackageVersion Include="Hangfire.Core" Version="1.8.24" />
    <PackageVersion Include="Hangfire.AspNetCore" Version="1.8.24" />
    <PackageVersion Include="Hangfire.PostgreSql" Version="1.21.1" />
    <!-- See the CPM note above: this pin is why transitive pinning is on. -->
    <PackageVersion Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>

  <!-- ======================= Logging =========================== -->
  <ItemGroup>
    <PackageVersion Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageVersion Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageVersion Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageVersion Include="Serilog.Enrichers.Environment" Version="3.0.1" />
  </ItemGroup>

  <!-- ======================= Testing =========================== -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
    <PackageVersion Include="Bogus" Version="35.6.5" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.11" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.14.0" />
    <PackageVersion Include="NetArchTest.eNhancedEdition" Version="1.4.5" />
  </ItemGroup>

</Project>
