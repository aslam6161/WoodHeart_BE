<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Use cases + PORTS. Declares interfaces (IOrderRepository, IPaymentProvider,
    ISmsSender, IUnitOfWork...) but implements none of them.
    Allowed dependencies: Domain + abstraction-only packages.
  -->

  <PropertyGroup>
    <RootNamespace>WoodHeart.Application</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Mediator.Abstractions" />

    <!-- The generator runs HERE, not in the API project: handlers are internal to
         this assembly, and a generator in another assembly cannot see them. It
         also puts handler registration in the layer that owns the handlers. -->
    <PackageReference Include="Mediator.SourceGenerator">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="FluentValidation" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" />
    <PackageReference Include="Riok.Mapperly" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WoodHeart.Domain\WoodHeart.Domain.csproj" />
  </ItemGroup>

  <!--
    Handlers and validators are `internal`: nothing outside this assembly should
    ever construct a handler directly — callers dispatch a command through the
    pipeline so validation, authorization and the transaction boundary all apply.
    Tests are the one legitimate exception, and they get access explicitly rather
    than by weakening the encapsulation for everyone.
  -->
  <ItemGroup>
    <InternalsVisibleTo Include="WoodHeart.Application.UnitTests" />
  </ItemGroup>

</Project>
